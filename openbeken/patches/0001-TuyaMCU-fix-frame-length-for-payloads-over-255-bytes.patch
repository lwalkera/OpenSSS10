From dbbdcee40ca39bc86d1e2b44114a8ea5daf3ba37 Mon Sep 17 00:00:00 2001
From: Laine Walker-Avina <lwalkera@ieee.org>
Date: Wed, 30 Sep 2026 00:36:14 -0700
Subject: [PATCH 1/3] TuyaMCU: fix frame length for payloads over 255 bytes

The length bytes were combined with lena >> 8 instead of lena << 8, which
drops the high byte:

- UART_TryToGetNextTuyaPacket took a frame with a payload over 255 bytes
  as shorter than it is. It split the frame and parsed the rest of the
  payload as new data, so any 55 AA inside it became a packet. Such frames
  are too large for the receive buffer; they are now skipped whole.
- ProcessIncoming's length check discarded every frame with a payload
  over 255 bytes.

Test_TuyaMCU_Robustness gets a 300-byte frame that hides a STATE packet.
---
 src/driver/drv_tuyaMCU.c        |  4 +--
 src/selftest/selftest_tuyaMCU.c | 48 +++++++++++++++++++++++++++++++++
 2 files changed, 50 insertions(+), 2 deletions(-)

diff --git a/src/driver/drv_tuyaMCU.c b/src/driver/drv_tuyaMCU.c
index c82394d7..08305e5a 100644
--- a/src/driver/drv_tuyaMCU.c
+++ b/src/driver/drv_tuyaMCU.c
@@ -423,7 +423,7 @@ int UART_TryToGetNextTuyaPacket(byte* out, int maxSize) {
 	command = UART_GetByte(3);
 	lena = UART_GetByte(4); // hi
 	lenb = UART_GetByte(5); // lo
-	len = lenb | lena >> 8;
+	len = lenb | lena << 8;
 	// now check if we have received whole packet
 	len += 2 + 1 + 1 + 2 + 1; // header 2 bytes, version, command, lenght, chekcusm
 	if (cs >= len) {
@@ -2030,7 +2030,7 @@ void TuyaMCU_ProcessIncoming(const byte* data, int len) {
 		return;
 	}
 	version = data[2];
-	checkLen = data[5] | data[4] >> 8;
+	checkLen = data[5] | data[4] << 8;
 	checkLen = checkLen + 2 + 1 + 1 + 2 + 1;
 	if (checkLen != len) {
 		addLogAdv(LOG_INFO, LOG_FEATURE_TUYAMCU, "ProcessIncoming: discarding packet bad expected len, expected %i and got len %i", checkLen, len);
diff --git a/src/selftest/selftest_tuyaMCU.c b/src/selftest/selftest_tuyaMCU.c
index 16cca434..e90a6ff6 100644
--- a/src/selftest/selftest_tuyaMCU.c
+++ b/src/selftest/selftest_tuyaMCU.c
@@ -841,6 +841,54 @@ void Test_TuyaMCU_Robustness() {
 	CMD_ExecuteCommand("uartFakeHex 55AA0008000F0000000000000001020004000000011E", 0);
 	Sim_RunFrames(100, false);
 	SELFTEST_ASSERT_CHANNEL(22, 1);
+
+	// -----------------------------------------------------------------------
+	// Part 4: Frame with a payload over 255 bytes (too large for the driver)
+	//
+	// The 300-byte payload hides a STATE packet setting dpId 1 to 55. The
+	// whole frame must be skipped: taking the length from its low byte only
+	// would split it and parse the hidden packet.
+	// -----------------------------------------------------------------------
+	{
+		static const byte hidden[] = { 0x55, 0xAA, 0x03, 0x07, 0x00, 0x08,
+			0x01, 0x02, 0x00, 0x04, 0x00, 0x00, 0x00, 0x37, 0x4F };
+		byte frame[6 + 300 + 1];
+		char hex[16 + 2 * sizeof(frame)];
+		byte sum = 0;
+		int i;
+
+		SIM_ClearOBK(0);
+		SIM_UART_InitReceiveRingBuffer(2048);
+		CMD_ExecuteCommand("startDriver TuyaMCU", 0);
+		CMD_ExecuteCommand("linkTuyaMCUOutputToChannel 1 val 20", 0);
+		CMD_ExecuteCommand("setChannel 20 99", 0);
+
+		memset(frame, 0, sizeof(frame));
+		frame[0] = 0x55;
+		frame[1] = 0xAA;
+		frame[2] = 0x03;
+		frame[3] = 0x07;
+		frame[4] = 300 >> 8;
+		frame[5] = 300 & 0xFF;
+		memcpy(frame + 6 + 100, hidden, sizeof(hidden));
+		for (i = 0; i < (int)sizeof(frame) - 1; i++) {
+			sum += frame[i];
+		}
+		frame[sizeof(frame) - 1] = sum;
+
+		strcpy(hex, "uartFakeHex ");
+		for (i = 0; i < (int)sizeof(frame); i++) {
+			sprintf(hex + strlen(hex), "%02X", frame[i]);
+		}
+		CMD_ExecuteCommand(hex, 0);
+		Sim_RunFrames(100, false);
+		SELFTEST_ASSERT_CHANNEL(20, 99);
+
+		// the next frame is still parsed
+		CMD_ExecuteCommand("uartFakeHex 55AA03070008010200040000000119", 0);
+		Sim_RunFrames(100, false);
+		SELFTEST_ASSERT_CHANNEL(20, 1);
+	}
 }
 
 #endif
