From 90f15bb2d61552eb0b6b87e0109eb4630dda101c Mon Sep 17 00:00:00 2001
From: Laine Walker-Avina <lwalkera@ieee.org>
Date: Sun, 11 Oct 2026 21:49:45 -0700
Subject: [PATCH 3/3] TuyaMCU OTA: send packets without blocking the quick tick

On a BK7231N the first update restarted the module through the
hardware watchdog after about 11 s. Each 0x0B packet was written with
TuyaMCU_SendCommandWithData, whose UART_SendByte calls wait while the
TX FIFO is full. A 263-byte packet takes about 0.27 s at 9600 baud,
and packets go out back to back. On Beken, QuickTick runs as a timer
callback, so this starved the rest of the system, including the web
server and the once-a-second task that reloads the watchdog.

Frames are now built in the OTA module and written a few bytes per
tick, paced to the TuyaMCU baud rate (at most 32 bytes per tick), so
the UART never makes the caller wait. Timeouts start once a frame has
left the UART.

While the update owns the UART (start and data packets), other
TuyaMCU frames would interleave with a half-written packet, so the
state machine pauses and TuyaMCU_SendCommandWithData drops frames
with a log message. Heartbeats resume once all data is sent, so the
MCU's restart is still seen.

The self-test now checks that nothing else is sent during a transfer,
including a tuyaMcu_sendCmd issued mid-transfer, and that heartbeats
resume afterwards.
---
 src/driver/drv_tuyaMCU.c            | 23 ++++++++
 src/driver/drv_tuyaMCU.h            |  1 +
 src/driver/drv_tuyaMCU_ota.c        | 85 ++++++++++++++++++++++++++++-
 src/driver/drv_tuyaMCU_ota.h        |  4 ++
 src/selftest/selftest_tuyaMCU_ota.c | 17 +++++-
 5 files changed, 126 insertions(+), 4 deletions(-)

diff --git a/src/driver/drv_tuyaMCU.c b/src/driver/drv_tuyaMCU.c
index aa237f31..c9c96ccc 100644
--- a/src/driver/drv_tuyaMCU.c
+++ b/src/driver/drv_tuyaMCU.c
@@ -204,6 +204,10 @@ static int g_dimmerRangeMax = 100;
 // common baud rates are 9600 bit/s and 115200 bit/s
 static int g_baudRate = 9600;
 
+int TuyaMCU_GetBaudRate() {
+	return g_baudRate;
+}
+
 // global mcu time
 static int g_tuyaNextRequestDelay;
 static bool g_sensorMode = 0;
@@ -454,6 +458,15 @@ int UART_TryToGetNextTuyaPacket(byte* out, int maxSize) {
 // append header, len, everything, checksum
 void TuyaMCU_SendCommandWithData(byte cmdType, byte* data, int payload_len) {
 	int i;
+
+#if ENABLE_TUYAMCU_OTA
+	// The MCU update sends its own frames a few bytes per tick; another frame
+	// written now would be interleaved with them
+	if (TuyaMCU_OTA_OwnsUART()) {
+		addLogAdv(LOG_INFO, LOG_FEATURE_TUYAMCU, "MCU update in progress, not sending cmd %i", cmdType);
+		return;
+	}
+#endif
 	
 	byte check_sum = (0xFF + cmdType + (payload_len >> 8) + (payload_len & 0xFF));
 
@@ -2611,6 +2624,11 @@ void TuyaMCU_RunFrame() {
 	if (timer_send > 0) {
 		timer_send -= g_deltaTimeMS;
 	}
+#if ENABLE_TUYAMCU_OTA
+	else if (TuyaMCU_OTA_OwnsUART()) {
+		// queued packets wait until the MCU update has finished sending
+	}
+#endif
 	else {
 		if (TUYAMCU_SendFromQueue()) {
 			timer_send = 100;
@@ -2618,6 +2636,11 @@ void TuyaMCU_RunFrame() {
 	}
 }
 void TuyaMCU_RunEverySecond() {
+#if ENABLE_TUYAMCU_OTA
+	if (TuyaMCU_OTA_OwnsUART()) {
+		return;
+	}
+#endif
 	g_sensorMode = DRV_IsRunning("tmSensor");
 	if (g_sensorMode) {
 		TuyaMCU_RunStateMachine_BatteryPowered();
diff --git a/src/driver/drv_tuyaMCU.h b/src/driver/drv_tuyaMCU.h
index 4cdab1dc..a2e0402c 100644
--- a/src/driver/drv_tuyaMCU.h
+++ b/src/driver/drv_tuyaMCU.h
@@ -7,6 +7,7 @@ void TuyaMCU_Send(byte *data, int size);
 void TuyaMCU_OnChannelChanged(int channel,int iVal);
 void TuyaMCU_Send_RawBuffer(byte *data, int len);
 void TuyaMCU_SendCommandWithData(byte cmdType, byte* data, int payload_len);
+int TuyaMCU_GetBaudRate();
 bool TuyaMCU_IsChannelUsedByTuyaMCU(int channelIndex);
 void TuyaMCU_ForcePublishChannelValues();
