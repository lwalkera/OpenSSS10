From a0c0632527ea021e6ad5d89ddc1ef1616af90b40 Mon Sep 17 00:00:00 2001
From: Laine Walker-Avina <lwalkera@ieee.org>
Date: Wed, 30 Sep 2026 00:36:14 -0700
Subject: [PATCH 1/3] TuyaMCU: fix frame length check for payloads over 255
 bytes

ProcessIncoming combined the length bytes with data[4] >> 8 instead of
data[4] << 8, so any received frame with a payload longer than 255
bytes failed the length check and was discarded.
---
 src/driver/drv_tuyaMCU.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/driver/drv_tuyaMCU.c b/src/driver/drv_tuyaMCU.c
index c82394d7..d131beda 100644
--- a/src/driver/drv_tuyaMCU.c
+++ b/src/driver/drv_tuyaMCU.c
@@ -2030,7 +2030,7 @@ void TuyaMCU_ProcessIncoming(const byte* data, int len) {
 		return;
 	}
 	version = data[2];
-	checkLen = data[5] | data[4] >> 8;
+	checkLen = data[5] | data[4] << 8;
 	checkLen = checkLen + 2 + 1 + 1 + 2 + 1;
 	if (checkLen != len) {
 		addLogAdv(LOG_INFO, LOG_FEATURE_TUYAMCU, "ProcessIncoming: discarding packet bad expected len, expected %i and got len %i", checkLen, len);
-- 
